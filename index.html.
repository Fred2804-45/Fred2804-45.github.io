<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Okafor Frederick Chibuike | Administrative and Social Media Virtual Assistant</title>
<meta name="description" content="By Fred: administrative and social media virtual assistant helping entrepreneurs, businesses and brands stay organised and visible online.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --wine:#5A1424; --wine-2:#7B2236; --rose:#D8A9A3; --cream:#F7F0E4; --cream-2:#EDE2D0; --ink:#2A1519; --muted:#6B555A; --line:#d9c9b4;
  --head:'Bricolage Grotesque','Trebuchet MS',system-ui,sans-serif; --body:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--ink);background:var(--cream);line-height:1.7;font-size:17px}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:3px solid var(--wine-2);outline-offset:3px}
.wrap{width:min(1080px,90%);margin-inline:auto}
section{padding:96px 0}
h1,h2,h3{font-family:var(--head);line-height:1.08;color:var(--wine)}
h2{font-size:clamp(1.9rem,4vw,2.7rem);font-weight:600;margin-bottom:14px;letter-spacing:-.01em}
.lead{color:var(--muted);max-width:56ch;margin-bottom:44px}
.btn{display:inline-block;padding:12px 26px;border-radius:999px;font-weight:600;text-decoration:none;border:1.5px solid var(--wine);transition:background .2s,color .2s}
.btn.solid{background:var(--wine);color:var(--cream)}
.btn.solid:hover{background:var(--wine-2);border-color:var(--wine-2)}
.btn.line{color:var(--wine)}
.btn.line:hover{background:var(--wine);color:var(--cream)}

header{position:sticky;top:0;z-index:20;background:rgba(247,240,228,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;height:66px}
.logo{font-family:var(--head);font-weight:800;font-size:1.2rem;color:var(--wine);text-decoration:none}
nav ul{display:flex;gap:26px;list-style:none;padding:0}
nav ul a{text-decoration:none;font-weight:500;font-size:.95rem;color:var(--ink)}
nav ul a:hover{color:var(--wine);text-decoration:underline;text-decoration-color:var(--rose);text-underline-offset:7px;text-decoration-thickness:2px}

/* hero */
.hero{padding:72px 0 0;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:end}
.hero-text{padding-bottom:88px}
.hero h1{font-size:clamp(2.6rem,6.2vw,5.2rem);font-weight:800;letter-spacing:-.025em}
.hero h1 span{display:block;white-space:nowrap}
.hero h1 .touch{color:var(--wine-2);padding-left:.8em;opacity:.78}
.name{font-family:var(--head);font-size:1.3rem;font-weight:600;margin:28px 0 4px;color:var(--ink)}
.role{color:var(--muted);max-width:44ch}
.cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}
.arch{position:relative;width:100%;max-width:400px;height:500px;justify-self:center;background:var(--wine);border-radius:200px 200px 0 0;overflow:hidden}
.arch::after{content:"";position:absolute;inset:14px;border:1.5px solid rgba(216,169,163,.55);border-radius:186px 186px 0 0;pointer-events:none}
.arch img{position:absolute;bottom:0;left:50%;width:96%;max-width:none;transform:translateX(-50%)}
.initials{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--head);font-weight:800;font-size:5rem;color:var(--rose)}

/* about */
.about{background:var(--cream-2)}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
.tags{display:flex;flex-wrap:wrap;gap:10px}
.tag{border:1.5px solid var(--wine);color:var(--wine);padding:6px 16px;border-radius:999px;font-weight:500;font-size:.92rem;background:transparent}

/* services */
.service{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;padding:40px 0;border-top:1.5px solid var(--wine)}
.service:last-of-type{border-bottom:1.5px solid var(--wine)}
.service h3{font-size:1.65rem;font-weight:600;margin-bottom:12px}
.service p{color:var(--muted)}
.service ul{list-style:none;padding:0;display:grid;gap:9px;align-content:start}
.service li{padding-left:26px;position:relative}
.service li::before{content:"";position:absolute;left:0;top:.62em;width:12px;height:6px;border-left:2px solid var(--wine-2);border-bottom:2px solid var(--wine-2);transform:rotate(-45deg) translateY(-50%)}
.also{margin-top:34px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.also strong{font-family:var(--head);color:var(--wine);font-weight:600}

/* skills */
.skills{background:var(--wine);color:var(--cream)}
.skills h2{color:var(--cream)}
.skills .lead{color:#e6cfc9}
.cols{display:grid;grid-template-columns:repeat(3,1fr);gap:44px}
.skills h3{font-size:1.15rem;font-weight:600;margin-bottom:16px;color:var(--rose)}
.skills ul{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:9px}
.skills li{border:1px solid rgba(216,169,163,.6);border-radius:999px;padding:5px 14px;font-size:.92rem}

/* cards */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:28px}
.card{background:var(--cream-2);border-radius:20px;padding:34px;display:flex;flex-direction:column;gap:14px}
.card .cat{align-self:flex-start;background:var(--wine);color:var(--cream);font-weight:500;font-size:.85rem;padding:3px 14px;border-radius:999px}
.card h3{font-size:1.4rem;font-weight:600}
.card p{color:var(--muted)}
.card dl{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:.94rem;padding-top:16px;border-top:1px solid var(--line);margin-top:auto}
.card dt{font-weight:600;color:var(--wine)}
.card dd{margin:0}
.card .row{display:flex;gap:10px;flex-wrap:wrap}
.card .btn{padding:7px 18px;font-size:.92rem}

/* experience */
.exp{background:var(--cream-2)}
.job{display:grid;grid-template-columns:220px 1fr;gap:36px;padding:32px 0;border-top:1.5px solid var(--wine)}
.job:last-child{border-bottom:1.5px solid var(--wine)}
.job .when{color:var(--muted);font-size:.95rem}
.job .when strong{display:block;color:var(--wine);font-family:var(--head);font-size:1.05rem;font-weight:600}
.job img{height:44px;width:auto;margin-bottom:12px}
.job h3{font-size:1.4rem;font-weight:600}
.job .co{font-weight:600;margin-bottom:10px;color:var(--ink)}
.job ul{padding-left:20px;display:grid;gap:6px;color:var(--muted)}
.quote{padding:32px;border-radius:20px;background:var(--wine);color:var(--cream);display:flex;flex-direction:column;gap:18px}
.quote blockquote{font-family:var(--head);font-size:1.2rem;line-height:1.4}
.quote cite{font-style:normal;color:#e6cfc9;font-size:.93rem}
.quote cite strong{color:var(--rose);display:block}

/* contact */
.contact{text-align:center;background:var(--wine);color:var(--cream)}
.contact h2{color:var(--cream);font-size:clamp(2.2rem,6vw,3.8rem)}
.contact .lead{margin-inline:auto;color:#e6cfc9}
.links{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.contact .btn{border-color:var(--cream);color:var(--cream)}
.contact .btn.solid{background:var(--cream);color:var(--wine)}
.contact .btn.solid:hover{background:var(--rose);border-color:var(--rose)}
.contact .btn.line:hover{background:var(--cream);color:var(--wine)}
footer{background:#46101c;color:#d9bcb6;text-align:center;padding:24px 0;font-size:.9rem}

@media(max-width:860px){
  nav ul{display:none}
  .hero .wrap,.about .wrap,.service,.job,.cols{grid-template-columns:1fr}
  .hero{padding-top:44px}
  .hero-text{padding-bottom:40px}
  .arch{max-width:320px;height:420px;border-radius:160px 160px 0 0}
  .arch::after{border-radius:146px 146px 0 0}
  section{padding:64px 0}
  .cards{grid-template-columns:1fr}
  .hero h1 .touch{padding-left:.4em}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
<body>

<header>
  <nav class="wrap" aria-label="Main">
    <a class="logo" href="#top">By Fred</a>
    <ul>
      <li><a href="#about">About</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#skills">Skills</a></li>
      <li data-sec="projects"><a href="#work">Work</a></li>
      <li data-sec="jobs"><a href="#experience">Experience</a></li>
      <li data-sec="testimonials"><a href="#testimonials">Testimonials</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <h1 aria-label="Your vision, my touch"><span>Your vision.</span><span class="touch">My touch.</span></h1>
        <p class="name" id="name"></p>
        <p class="role" id="title"></p>
        <div class="cta">
          <a class="btn solid" href="#contact">Work with me</a>
          <a class="btn line" href="#services">See my services</a>
        </div>
      </div>
      <div class="arch" id="arch">
        <img id="photoImg" src="data:image/webp;base64," alt="Portrait of Okafor Frederick Chibuike">
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="wrap">
      <div>
        <h2>About me</h2>
        <p id="bio"></p>
      </div>
      <div>
        <h2>Where I can help</h2>
        <div class="tags" id="roles"></div>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <h2>Services</h2>
      <p class="lead">Choose one service or combine them. Each one is built to give you your time back.</p>
      <div id="serviceList"></div>
      <div class="also" id="also"></div>
    </div>
  </section>

  <section class="skills" id="skills">
    <div class="wrap">
      <h2>Skills and tools</h2>
      <p class="lead">What I’m good at and what I use to get it done.</p>
      <div class="cols">
        <div><h3>Hard skills</h3><ul id="hard"></ul></div>
        <div><h3>Soft skills</h3><ul id="soft"></ul></div>
        <div><h3>Tools</h3><ul id="tools"></ul></div>
      </div>
    </div>
  </section>

  <section id="work" data-sec="projects">
    <div class="wrap">
      <h2>Proof of work</h2>
      <p class="lead">The problem, what I did, and what the client got.</p>
      <div class="cards" id="projectList"></div>
    </div>
  </section>

  <section class="exp" id="experience" data-sec="jobs">
    <div class="wrap">
      <h2>Work experience</h2>
      <div id="jobList" style="margin-top:32px"></div>
    </div>
  </section>

  <section id="testimonials" data-sec="testimonials">
    <div class="wrap">
      <h2>Kind words</h2>
      <p class="lead">What clients say about working with me.</p>
      <div class="cards" id="quoteList"></div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <h2>Let’s get you organised</h2>
      <p class="lead">Tell me what’s piling up and I’ll show you how I can take it off your plate.</p>
      <div class="links" id="links"></div>
    </div>
  </section>
</main>

<footer><div class="wrap">&copy; <span id="year"></span> Okafor Frederick Chibuike. By Fred.</div></footer>

<script>
/* ============ EDIT YOUR CONTENT HERE ============
   Leave a list empty ([]) and its section hides itself.
   Your photo is embedded in this file, so nothing else needs uploading. */
const SITE = {
  name: "Okafor Frederick Chibuike",
  title: "Administrative and Social Media Virtual Assistant",
  bio: "I’m an Administrative and Social Media Virtual Assistant who helps entrepreneurs, businesses and brands stay organised, strengthen their online presence and manage essential day-to-day operations. I support clients with email and calendar management, travel planning, content creation, social media management and general administrative tasks, helping clients improve productivity and focus on achieving their goals.",

  email: "okaforfrederick2004@gmail.com",
  whatsapp: "2349150572380",
  x: "https://x.com/OkaforFrederick",
  instagram: "official_fred_dy",
  linkedin: "https://www.linkedin.com/in/okafor-frederick-2960023b3",

  roles: ["Administrative support", "Email management", "Calendar management", "Travel planning", "Social media management", "Content creation", "Content planning", "Community management", "Digital marketing", "Medical laboratory science"],

  services: [
    { name: "Administrative Support",
      desc: "I help entrepreneurs, professionals, companies and brands manage their daily administrative tasks, stay organised and work more efficiently. My goal is to take routine tasks off your plate so you can focus on your priorities and business goals.",
      tasks: ["Email management and organisation", "Calendar management and appointment scheduling", "Travel planning and itinerary preparation", "Meeting scheduling and agenda preparation", "Document preparation and organisation", "Data entry and record keeping", "Internet research and information gathering", "SOP creation and workflow organisation"] },
    { name: "Social Media Management",
      desc: "I help businesses and brands maintain an active, organised and engaging social media presence. From planning content to managing accounts, I support brands in communicating with their audience, building visibility and keeping a consistent online identity.",
      tasks: ["Social media account management", "Content calendar creation", "Content scheduling and publishing", "Caption writing and copywriting", "Social media profile optimisation", "Audience engagement and community management", "Hashtag and content research", "Performance tracking and reporting"] },
    { name: "Content Creation",
      desc: "I help brands communicate their ideas through creative, engaging content that connects with their target audience. I develop content that reflects each brand’s identity, communicates its message clearly and supports its marketing goals across digital platforms.",
      tasks: ["Social media post creation", "Caption and post copywriting", "Content brainstorming and ideation", "Canva graphics and promotional designs", "Short-form video content planning", "Reel and TikTok content ideas", "Content repurposing", "Brand voice and messaging consistency"] }
  ],
  alsoOffering: ["Digital marketing support", "Research and documentation"],

  hardSkills: ["Administrative support", "Email and calendar management", "Social media management", "Travel planning", "Internet research and data entry", "Content creation", "Canva design", "Meeting coordination and agenda preparation", "SOP creation and documentation"],
  softSkills: ["Communication", "Organisation", "Time management", "Attention to detail", "Critical thinking", "Problem solving", "Adaptability", "Creativity", "Teamwork and collaboration", "Confidentiality and professionalism", "Research and analytical thinking"],
  tools: ["Google Workspace", "Notion", "Canva", "ClickUp", "ChatGPT", "Meta Business Suite", "CapCut", "Grammarly", "Slack", "Trello", "Metricool"],

  projects: [
    { category:"Social Media Management", title:"Social Media Audit & Growth Strategy for Mikky Couture",
      story:"Mikky Couture needed a more organised social media presence and a strategy to strengthen its brand identity and connect with its target audience. I reviewed its social media presence and developed recommendations for profile optimisation, content planning, audience engagement and brand consistency. I also proposed content series and strategies to improve visibility and encourage customer enquiries.",
      client:"Mikky Couture", type:"Social Media Audit & Strategy", format:"Account analysis, content strategy and recommendations",
      result:"Delivered actionable recommendations for improving profile presentation, content consistency, audience engagement and potential customer conversions.",
      links:[{label:"Instagram", url:"https://www.instagram.com/mikky_couture"},{label:"TikTok", url:"https://www.tiktok.com/@mikky_couture"}] },
    { category:"Content Creation", title:"TikTok Content Strategy for Stride & Kicks",
      story:"Stride & Kicks needed a more structured approach to showcasing its footwear products and attracting potential customers on TikTok. I developed content ideas focused on product visibility, audience engagement and brand awareness. I also worked on profile optimisation, video concepts, captions and a posting schedule to help the brand keep a consistent presence.",
      client:"Stride & Kicks", type:"Content Strategy & Social Media Support", format:"TikTok content bank, captions, video concepts and posting schedule",
      result:"Created a structured content plan the brand could use to showcase its products and maintain consistent posting.", links:[] }
  ],

  /* Dates were not supplied, so they stay hidden. Add dates:"Jan 2024 to Present" to any job to show them.
     Add logo:"logo.png" to show a company logo. */
  jobs: [
    { title:"Administrative & Social Media Virtual Assistant", company:"By Fred (Self-Employed)", type:"Remote",
      bullets:["Manage email inboxes, calendars and appointment scheduling for clients","Plan travel and prepare itineraries","Prepare documents, SOPs and workflow guides","Plan, create and schedule social media content","Run research, data entry and record keeping","Support brand growth through engagement and content strategy"] },
    { title:"Social Media Manager", company:"Mikky Couture", type:"Remote",
      bullets:["Audited the brand’s social media presence","Recommended profile optimisation and brand consistency improvements","Planned content series and a content strategy","Proposed engagement strategies to encourage customer enquiries","Delivered recommendations aimed at improving visibility and conversions"] },
    { title:"Social Media & Content Support", company:"Stride & Kicks", type:"Remote",
      bullets:["Built a TikTok content bank focused on product visibility","Developed video concepts for the brand’s footwear","Wrote captions for planned posts","Created a posting schedule for consistent output","Optimised the brand’s profile to attract potential customers"] }
  ],

  /* Example: { quote:"Fred made my week easier.", name:"Client name", role:"Founder, Company" } */
  testimonials: []
};
/* ================================================= */

const $ = id => document.getElementById(id);
const el = (tag, cls, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; return e; };
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

$("name").textContent = SITE.name;
$("title").textContent = SITE.title;
$("bio").textContent = SITE.bio;
$("year").textContent = new Date().getFullYear();

$("photoImg").addEventListener("error", () => {
  const initials = SITE.name.split(" ").slice(0,2).map(w => w[0]).join("");
  $("photoImg").remove();
  $("arch").insertAdjacentHTML("beforeend", '<span class="initials" aria-hidden="true">' + esc(initials) + '</span>');
});

SITE.roles.forEach(r => $("roles").append(el("span","tag",esc(r))));
[["hard",SITE.hardSkills],["soft",SITE.softSkills],["tools",SITE.tools]].forEach(([id,list]) => list.forEach(x => $(id).append(el("li","",esc(x)))));

SITE.services.forEach(s => $("serviceList").append(el("article","service",
  "<div><h3>"+esc(s.name)+"</h3><p>"+esc(s.desc)+"</p></div><ul>"+s.tasks.map(t=>"<li>"+esc(t)+"</li>").join("")+"</ul>")));
if (SITE.alsoOffering.length) $("also").innerHTML = "<strong>Also offering</strong>" + SITE.alsoOffering.map(a => '<span class="tag">'+esc(a)+'</span>').join("");

SITE.projects.forEach(p => {
  const links = (p.links||[]).length ? '<div class="row">'+p.links.map(l => '<a class="btn line" href="'+esc(l.url)+'" target="_blank" rel="noopener">'+esc(l.label)+'</a>').join("")+'</div>' : "";
  $("projectList").append(el("article","card",
    '<span class="cat">'+esc(p.category)+'</span><h3>'+esc(p.title)+'</h3><p>'+esc(p.story)+'</p>'+
    '<dl><dt>Client</dt><dd>'+esc(p.client)+'</dd><dt>Type</dt><dd>'+esc(p.type)+'</dd><dt>Format</dt><dd>'+esc(p.format)+'</dd><dt>Result</dt><dd>'+esc(p.result)+'</dd></dl>'+links));
});

SITE.jobs.forEach(j => {
  const logo = j.logo ? '<img src="'+esc(j.logo)+'" alt="'+esc(j.company)+' logo">' : "";
  const dates = j.dates ? '<strong>'+esc(j.dates)+'</strong>' : "";
  $("jobList").append(el("article","job",
    '<div class="when">'+logo+dates+esc(j.type)+'</div>'+
    '<div><h3>'+esc(j.title)+'</h3><p class="co">'+esc(j.company)+'</p><ul>'+j.bullets.map(b=>"<li>"+esc(b)+"</li>").join("")+'</ul></div>'));
});

SITE.testimonials.forEach(t => $("quoteList").append(el("figure","quote",
  '<blockquote>&ldquo;'+esc(t.quote)+'&rdquo;</blockquote><cite><strong>'+esc(t.name)+'</strong>'+esc(t.role)+'</cite>')));

const L = $("links");
L.append(Object.assign(el("a","btn solid","Email me"), {href:"mailto:"+SITE.email}));
if (SITE.whatsapp) L.append(Object.assign(el("a","btn line","WhatsApp"), {href:"https://wa.me/"+SITE.whatsapp.replace(/\D/g,""), target:"_blank", rel:"noopener"}));
if (SITE.x) L.append(Object.assign(el("a","btn line","X"), {href:SITE.x, target:"_blank", rel:"noopener"}));
if (SITE.instagram) L.append(Object.assign(el("a","btn line","Instagram"), {href:"https://instagram.com/"+SITE.instagram.replace("@",""), target:"_blank", rel:"noopener"}));
if (SITE.linkedin) L.append(Object.assign(el("a","btn line","LinkedIn"), {href:SITE.linkedin, target:"_blank", rel:"noopener"}));

[["projects","projects"],["jobs","jobs"],["testimonials","testimonials"]].forEach(([key,sec]) => {
  if (!SITE[key].length) document.querySelectorAll('[data-sec="'+sec+'"]').forEach(n => n.remove());
});
</script>
</body>
</html>
